# App Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Sealed httpOnly session (REQUIRED in production, ≥32 characters)
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-secret-32+

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sprech_mit_uns

# Prisma Connection String
DATABASE_URL=postgresql://postgres:postgres@db:5432/sprech_mit_uns?schema=public
DIRECT_DATABASE_URL=postgresql://postgres:postgres@db:5432/sprech_mit_uns?schema=public

# TTS: SMU_TTS_PROVIDER=google|off. NUXT_PUBLIC_TTS_MODE=auto|browser|proxy
# SMU_TTS_PROVIDER=google
# NUXT_PUBLIC_TTS_MODE=auto

# Dịch từ vựng. Có key thì dùng Cloud Translation API (chính thức, 500.000
# ký tự/tháng miễn phí); không có thì rơi về endpoint nội bộ của Google Dịch
# (không key, không SLA, có lúc bị chặn 429).
# GOOGLE_TRANSLATE_API_KEY=
# cloud|free|off — bỏ trống để tự chọn theo key ở trên. off = tắt hẳn dịch tự động.
# SMU_TRANSLATE_PROVIDER=

# Catalog/quiz writes: in production require SMU_ALLOW_CATALOG_WRITES=1
# and/or SMU_ADMIN_EMAILS=you@example.com
# Dictionary "Thêm từ" always requires an email in SMU_ADMIN_EMAILS.
# SMU_ALLOW_CATALOG_WRITES=1
# SMU_ADMIN_EMAILS=admin@sprech.local

# Demo account (Docker production: show button + allow login + ensure demo user on start)
# SMU_ALLOW_DEMO=1
# SMU_SEED_DEMO=1
# NUXT_PUBLIC_SHOW_DEMO=1
# Full catalog seed still runs from the host: pnpm exec prisma db seed

# Optional observability
# NUXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# NUXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production

# Demo multiplayer rooms (disabled in production unless set)
# SMU_ENABLE_ROOMS=1
